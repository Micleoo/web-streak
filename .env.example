# Database (Supabase PostgreSQL Connection String)
# Gunakan format Transaction Pooler (port 6543) atau Session Pooler / Direct (port 5432)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Better Auth Secret (Generate random string min 32 chars, contoh: openssl rand -base64 32)
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-characters"

# Base URL & App URL (Diisi di Vercel Environment Variables)
# Contoh: https://your-streak-app.vercel.app
APP_URL="https://your-streak-app.vercel.app"
BETTER_AUTH_URL="https://your-streak-app.vercel.app/api/auth"

# Supabase Client Credentials (Opsional jika ingin akses langsung Supabase SDK di client)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
